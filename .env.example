# ==================================
# TaskFlow — Environment Variables
# ==================================
#
# Copy this file to `.env` (and, for local-only overrides, `.env.local`)
# and fill in real values. Never commit real secrets.

# ----------------------------------
# Database
# ----------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ----------------------------------
# Authentication (NextAuth)
# ----------------------------------

# Secret used to sign/encrypt session JWTs and cookies.
# Generate one with: npx auth secret
AUTH_SECRET=

# ----------------------------------
# Email (Brevo)
# ----------------------------------

# API key for sending verification, password-reset, and account emails.
BREVO_API_KEY=

# Default sender name/email used for transactional messages.
BREVO_SENDER_NAME=TaskFlow
BREVO_SENDER_EMAIL=onboarding@taskflow.example

# Base URL used to build links inside emails (verification, password reset).
# Example: http://localhost:3000 (dev) or https://your-domain.com (prod)
NEXT_PUBLIC_APP_URL=

# ----------------------------------
# AI Assistant (Groq)
# ----------------------------------

# API key for the Groq API (OpenAI-compatible), used by the AI
# voice/text assistant to parse task commands.
GROQ_API_KEY=

# Informational label for which AI provider is configured. Not read by
# application code, but documents the current setup alongside the keys
# above.
AI_PROVIDER=groq

# Chat completion model used for intent parsing.
# Optional — defaults to "openai/gpt-oss-120b" if unset.
AI_MODEL=openai/gpt-oss-120b

# Timeout (in milliseconds) for AI requests before failing with a
# "taking too long to respond" error.
# Optional — defaults to 15000 if unset.
AI_REQUEST_TIMEOUT_MS=15000
